void setupBuzzer() {
#if ESP_ARDUINO_VERSION_MAJOR >= 3

  buzzerReady =
    ledcAttach(
      BUZZER_PIN,
      2000,
      8
    );

#else

  ledcSetup(
    0,
    2000,
    8
  );

  ledcAttachPin(
    BUZZER_PIN,
    0
  );

  buzzerReady = true;

#endif
}

void buzzerOn(
  int frequency
) {
  if (
    !buzzerReady
  ) {
    return;
  }

#if ESP_ARDUINO_VERSION_MAJOR >= 3

  ledcWriteTone(
    BUZZER_PIN,
    frequency
  );

#else

  ledcWriteTone(
    0,
    frequency
  );

#endif
}

void buzzerOff() {
  if (
    !buzzerReady
  ) {
    return;
  }

#if ESP_ARDUINO_VERSION_MAJOR >= 3

  ledcWriteTone(
    BUZZER_PIN,
    0
  );

#else

  ledcWriteTone(
    0,
    0
  );

#endif
}

