// ================================================================
// MEDICATION STATE
// ================================================================

String medStatus(
  int slot
) {
  if (
    medTaken[slot]
  ) {
    return "TAKEN";
  }

  if (
    medSkipped[slot]
  ) {
    return "SKIP";
  }

  if (
    medSnoozeUntil[slot] >
    millis()
  ) {
    return "SNOOZE";
  }

  if (
    !clockReady
  ) {
    return "WAIT";
  }

  struct tm info;

  if (
    !getLocalTime(
      &info,
      5
    )
  ) {
    return "WAIT";
  }

  int now =
    info.tm_hour *
    60 +
    info.tm_min;

  int due =
    medHour[slot] *
    60 +
    medMinute[slot];

  if (
    now >=
    due
  ) {
    return "DUE";
  }

  return "WAIT";
}

void markMedTaken(
  int slot
) {
  if (
    slot <
    0 ||
    slot >=
    MED_COUNT
  ) {
    return;
  }

  medTaken[slot] =
    true;

  medAlerted[slot] =
    true;

  medSkipped[slot] =
    false;

  medSnoozeUntil[slot] =
    0;

  if (
    medStock[slot] >
    0
  ) {
    medStock[slot]--;
  }

  saveMedDay();
  saveMedSchedule();

  redraw();
}

void snoozeMed(
  int slot
) {
  if (
    slot <
    0 ||
    slot >=
    MED_COUNT
  ) {
    return;
  }

  medAlerted[slot] =
    true;

  medSnoozeUntil[slot] =
    millis() +
    10UL *
    60UL *
    1000UL;

  saveMedDay();

  redraw();
}

void skipMed(
  int slot
) {
  if (
    slot <
    0 ||
    slot >=
    MED_COUNT
  ) {
    return;
  }

  medSkipped[slot] =
    true;

  medAlerted[slot] =
    true;

  medSnoozeUntil[slot] =
    0;

  saveMedDay();

  redraw();
}

String nextMedication() {
  if (
    !clockReady
  ) {
    return
      "WAITING FOR TIME";
  }

  struct tm info;

  if (
    !getLocalTime(
      &info,
      5
    )
  ) {
    return
      "WAITING";
  }

  int now =
    info.tm_hour *
    60 +
    info.tm_min;

  for (
    int i = 0;
    i < MED_COUNT;
    i++
  ) {
    if (
      medTaken[i] ||
      medSkipped[i]
    ) {
      continue;
    }

    if (
      medSnoozeUntil[i] >
      millis()
    ) {
      unsigned long minutes =
        (
          medSnoozeUntil[i] -
          millis()
        ) /
        60000UL;

      return
        String(
          medNames[i]
        ) +
        " SNOOZE " +
        String(
          minutes
        ) +
        "m";
    }

    int due =
      medHour[i] *
      60 +
      medMinute[i];

    if (
      now >=
      due
    ) {
      return
        String(
          medNames[i]
        ) +
        " DUE";
    }
  }

  int bestSlot = -1;
  int bestDifference = 99999;

  for (
    int i = 0;
    i < MED_COUNT;
    i++
  ) {
    if (
      medTaken[i] ||
      medSkipped[i]
    ) {
      continue;
    }

    int due =
      medHour[i] *
      60 +
      medMinute[i];

    int difference =
      due -
      now;

    if (
      difference >=
      0 &&
      difference <
      bestDifference
    ) {
      bestDifference =
        difference;

      bestSlot =
        i;
    }
  }

  if (
    bestSlot <
    0
  ) {
    return
      "ALL MEDS DONE";
  }

  int hours =
    bestDifference /
    60;

  int minutes =
    bestDifference %
    60;

  String output =
    String(
      medNames[
        bestSlot
      ]
    );

  output +=
    " ";

  if (
    hours >
    0
  ) {
    output +=
      String(
        hours
      );

    output +=
      "h ";
  }

  output +=
    String(
      minutes
    );

  output +=
    "m";

  return output;
}

// ================================================================
// ALARM
// ================================================================

void startAlarm(
  int reason
) {
  alarmActive =
    true;

  alarmReason =
    reason;

  alarmStep =
    0;

  lastAlarmTone =
    0;

  currentScreen =
    SCREEN_ALARM;

  redraw();
}

void stopAlarm() {
  alarmActive =
    false;

  buzzerOff();

  currentScreen =
    SCREEN_HOME;

  redraw();
}

void serviceAlarm() {
  if (
    !alarmActive
  ) {
    return;
  }

  if (
    millis() -
    lastAlarmTone <
    250
  ) {
    return;
  }

  lastAlarmTone =
    millis();

  alarmStep++;

  switch (
    alarmStep %
    6
  ) {
    case 0:
      buzzerOn(
        1800
      );
      break;

    case 1:
      buzzerOn(
        2400
      );
      break;

    case 2:
      buzzerOff();
      break;

    case 3:
      buzzerOn(
        3000
      );
      break;

    default:
      buzzerOff();
      break;
  }
}

// ================================================================
// MEDICATION SERVICE
// ================================================================

void serviceMedication() {
  if (
    !clockReady ||
    alarmActive
  ) {
    return;
  }

  int today =
    todayKey();

  if (
    today >=
    0 &&
    medicationDay !=
    today
  ) {
    resetMedicationDay(
      today
    );
  }

  for (
    int i = 0;
    i < MED_COUNT;
    i++
  ) {
    if (
      medTaken[i] ||
      medSkipped[i]
    ) {
      continue;
    }

    if (
      medSnoozeUntil[i] !=
      0 &&
      millis() >=
      medSnoozeUntil[i]
    ) {
      medSnoozeUntil[i] =
        0;

      activeMedication =
        i;

      startAlarm(
        1
      );

      return;
    }
  }

  struct tm info;

  if (
    !getLocalTime(
      &info,
      5
    )
  ) {
    return;
  }

  int now =
    info.tm_hour *
    60 +
    info.tm_min;

  for (
    int i = 0;
    i < MED_COUNT;
    i++
  ) {
    if (
      medTaken[i] ||
      medSkipped[i] ||
      medAlerted[i]
    ) {
      continue;
    }

    int due =
      medHour[i] *
      60 +
      medMinute[i];

    if (
      now >=
      due
    ) {
      medAlerted[i] =
        true;

      activeMedication =
        i;

      saveMedDay();

      startAlarm(
        1
      );

      return;
    }
  }
}

