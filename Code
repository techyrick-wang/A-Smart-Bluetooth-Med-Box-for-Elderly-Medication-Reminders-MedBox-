void wrappedText(
  String text,
  int x,
  int y,
  int charsPerLine,
  int lineHeight,
  int maxLines
) {
  tft.setTextSize(1);

  tft.setTextColor(
    C_TEXT
  );

  int start = 0;

  for (
    int line = 0;
    line < maxLines;
    line++
  ) {
    if (
      start >=
      (int)text.length()
    ) {
      break;
    }

    int end =
      start +
      charsPerLine;

    if (
      end >
      (int)text.length()
    ) {
      end =
        text.length();
    }

    if (
      end <
      (int)text.length()
    ) {
      int space =
        text.lastIndexOf(
          ' ',
          end
        );

      if (
        space >
        start
      ) {
        end = space;
      }
    }

    String part =
      text.substring(
        start,
        end
      );

    part.trim();

    tft.setCursor(
      x,
      y +
      line *
      lineHeight
    );

    tft.print(part);

    start = end;

    while (
      start <
      (int)text.length() &&
      text[start] ==
      ' '
    ) {
      start++;
    }
  }
}

