String formatMedTime(
  int hour,
  int minute
) {
  bool pm =
    hour >=
    12;

  int hour12 =
    hour %
    12;

  if (
    hour12 ==
    0
  ) {
    hour12 = 12;
  }

  String output =
    String(
      hour12
    );

  output += ":";

  if (
    minute <
    10
  ) {
    output += "0";
  }

  output +=
    String(
      minute
    );

  output +=
    pm
      ? " PM"
      : " AM";

  return output;
}

