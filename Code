// ================================================================
// SERIAL COMMANDS
// ================================================================

void processSerial(
  String command
) {
  command.trim();

  if (
    !command.length()
  ) {
    return;
  }

  Serial.print(
    "COMMAND: "
  );

  Serial.println(
    command
  );

  if (
    command ==
    "STATUS"
  ) {
    printStatus();

    return;
  }

  if (
    command ==
    "WIFI"
  ) {
    connectWiFi();

    return;
  }

  if (
    command ==
    "REFRESH"
  ) {
    refreshRequested =
      true;

    return;
  }

  if (
    command ==
    "LOCATIONAPI"
  ) {
    fetchIPLocation();

    return;
  }

  if (
    command ==
    "WEATHER"
  ) {
    fetchWeather();

    return;
  }

  if (
    command ==
    "PHARMACY"
  ) {
    searchPharmacies();

    return;
  }

  if (
    command ==
    "BEEP"
  ) {
    successBeep();

    return;
  }

  if (
    command ==
    "THEME"
  ) {
    lightTheme =
      !lightTheme;

    prefs.putBool(
      "light",
      lightTheme
    );

    redraw();

    return;
  }

  if (
    command ==
    "RESETMEDS"
  ) {
    int today =
      todayKey();

    if (
      today >=
      0
    ) {
      resetMedicationDay(
        today
      );
    }

    return;
  }

  if (
    command ==
    "DEFAULTMEDS"
  ) {
    medHour[0] = 8;
    medMinute[0] = 0;

    medHour[1] = 13;
    medMinute[1] = 0;

    medHour[2] = 20;
    medMinute[2] = 0;

    saveMedSchedule();

    redraw();

    return;
  }

  if (
    command ==
    "CLEARLOCATION"
  ) {
    prefs.remove(
      "hasloc"
    );

    prefs.remove(
      "locname"
    );

    prefs.remove(
      "region"
    );

    prefs.remove(
      "country"
    );

    prefs.remove(
      "timezone"
    );

    prefs.remove(
      "lat"
    );

    prefs.remove(
      "lon"
    );

    locationReady =
      false;

    manualLocation =
      false;

    weatherReady =
      false;

    redraw();

    return;
  }

  if (
    command.startsWith(
      "LOCATION="
    )
  ) {
    String search =
      command.substring(
        9
      );

    if (
      geocodeLocation(
        search
      )
    ) {
      fetchWeather();

      successBeep();
    } else {
      Serial.println(
        "LOCATION SEARCH FAILED"
      );

      errorBeep();
    }

    return;
  }

  if (
    command.startsWith(
      "STOCK"
    )
  ) {
    int equals =
      command.indexOf(
        '='
      );

    if (
      equals >
      5
    ) {
      int index =
        command.substring(
          5,
          equals
        ).toInt();

      int value =
        command.substring(
          equals +
          1
        ).toInt();

      if (
        index >=
        0 &&
        index <
        MED_COUNT
      ) {
        medStock[index] =
          value;

        saveMedSchedule();

        redraw();
      }
    }

    return;
  }

  if (
    command.startsWith(
      "LOW"
    )
  ) {
    int equals =
      command.indexOf(
        '='
      );

    if (
      equals >
      3
    ) {
      int index =
        command.substring(
          3,
          equals
        ).toInt();

      int value =
        command.substring(
          equals +
          1
        ).toInt();

      if (
        index >=
        0 &&
        index <
        MED_COUNT
      ) {
        medLow[index] =
          value;

        saveMedSchedule();

        redraw();
      }
    }

    return;
  }

  if (
    command.startsWith(
      "CARDNAME="
    )
  ) {
    cardName =
      command.substring(
        9
      );

    prefs.putString(
      "cardname",
      cardName
    );

    return;
  }

  if (
    command.startsWith(
      "CARDCONTACT="
    )
  ) {
    cardContact =
      command.substring(
        12
      );

    prefs.putString(
      "cardcontact",
      cardContact
    );

    return;
  }

  if (
    command.startsWith(
      "CARDALLERGIES="
    )
  ) {
    cardAllergies =
      command.substring(
        14
      );

    prefs.putString(
      "allergies",
      cardAllergies
    );

    return;
  }

  if (
    command.startsWith(
      "CARDMEDS="
    )
  ) {
    cardMeds =
      command.substring(
        9
      );

    prefs.putString(
      "cardmeds",
      cardMeds
    );

    return;
  }

  if (
    command.startsWith(
      "ICEPHONE="
    )
  ) {
    emergencyPhone =
      command.substring(
        9
      );

    prefs.putString(
      "icephone",
      emergencyPhone
    );

    return;
  }

  Serial.println(
    "UNKNOWN COMMAND"
  );
}

void serviceSerial() {
  while (
    Serial.available()
  ) {
    char c =
      Serial.read();

    if (
      c ==
      '\n' ||
      c ==
      '\r'
    ) {
      if (
        serialBuffer.length()
      ) {
        processSerial(
          serialBuffer
        );

        serialBuffer =
          "";
      }
    } else {
      serialBuffer += c;
    }
  }
}

