void startClock() {
  configTzTime(
    DEFAULT_TZ,
    NTP1,
    NTP2,
    NTP3
  );

  clockReady =
    false;
}

void serviceClock() {
  if (
    !WiFi.isConnected()
  ) {
    return;
  }

  if (
    millis() -
    lastClockCheck <
    1000
  ) {
    return;
  }

  lastClockCheck =
    millis();

  struct tm info;

  if (
    getLocalTime(
      &info,
      5
    )
  ) {
    if (
      !clockReady
    ) {
      clockReady =
        true;

      Serial.println(
        "CLOCK READY"
      );

      redraw();
    }
  }
}

