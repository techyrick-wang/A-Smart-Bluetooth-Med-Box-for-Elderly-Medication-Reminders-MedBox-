// ================================================================
// DISTANCE
//
// IMPORTANT FIX:
// Arduino already defines radians() as a macro.
// DO NOT use a function called radians().
// ================================================================

double degreesToRadians(
  double degrees
) {
  return
    degrees *
    PI /
    180.0;
}

float calculateDistanceKm(
  double lat1,
  double lon1,
  double lat2,
  double lon2
) {
  double dLat =
    degreesToRadians(
      lat2 -
      lat1
    );

  double dLon =
    degreesToRadians(
      lon2 -
      lon1
    );

  double a =
    sin(
      dLat /
      2.0
    ) *
    sin(
      dLat /
      2.0
    ) +

    cos(
      degreesToRadians(
        lat1
      )
    ) *

    cos(
      degreesToRadians(
        lat2
      )
    ) *

    sin(
      dLon /
      2.0
    ) *

    sin(
      dLon /
      2.0
    );

  double c =
    2.0 *
    atan2(
      sqrt(a),
      sqrt(
        1.0 -
        a
      )
    );

  return
    6371.0 *
    c;
}

// ================================================================
// PHARMACY HELPERS
//
// NO Pharmacy struct is passed into function arguments.
// This avoids the .ino auto-prototype issue you hit earlier.
// ================================================================

bool pharmacyDuplicate(
  String name,
  float distance
) {
  for (
    int i = 0;
    i < pharmacyCount;
    i++
  ) {
    if (
      pharmacies[i].name ==
      name &&
      fabs(
        pharmacies[i].distanceKm -
        distance
      ) <
      0.05
    ) {
      return true;
    }
  }

  return false;
}

void addPharmacy(
  String name,
  String address,
  String phone,
  String hours,
  double pLat,
  double pLon,
  float distance
) {
  if (
    pharmacyDuplicate(
      name,
      distance
    )
  ) {
    return;
  }

  int insertAt =
    0;

  while (
    insertAt <
    pharmacyCount &&
    pharmacies[insertAt].distanceKm <=
    distance
  ) {
    insertAt++;
  }

  if (
    pharmacyCount <
    MAX_PHARMACIES
  ) {
    pharmacyCount++;
  } else if (
    insertAt >=
    MAX_PHARMACIES
  ) {
    return;
  }

  for (
    int i =
      pharmacyCount -
      1;
    i >
      insertAt;
    i--
  ) {
    pharmacies[i] =
      pharmacies[i - 1];
  }

  pharmacies[insertAt].name =
    name;

  pharmacies[insertAt].address =
    address;

  pharmacies[insertAt].phone =
    phone;

  pharmacies[insertAt].hours =
    hours;

  pharmacies[insertAt].lat =
    pLat;

  pharmacies[insertAt].lon =
    pLon;

  pharmacies[insertAt].distanceKm =
    distance;
}

String buildPharmacyAddress(
  JsonObject tags
) {
  String house =
    tags["addr:housenumber"] |
    "";

  String street =
    tags["addr:street"] |
    "";

  String city =
    tags["addr:city"] |
    "";

  String full =
    tags["addr:full"] |
    "";

  String output = "";

  if (
    house.length()
  ) {
    output +=
      house;
  }

  if (
    street.length()
  ) {
    if (
      output.length()
    ) {
      output +=
        " ";
    }

    output +=
      street;
  }

  if (
    city.length()
  ) {
    if (
      output.length()
    ) {
      output +=
        ", ";
    }

    output +=
      city;
  }

  if (
    !output.length()
  ) {
    output =
      full;
  }

  if (
    !output.length()
  ) {
    output =
      "ADDRESS NOT LISTED";
  }

  return output;
}

