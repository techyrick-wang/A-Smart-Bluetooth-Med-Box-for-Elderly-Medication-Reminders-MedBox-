      char timeBuffer[12];

      strftime(
        timeBuffer,
        sizeof(timeBuffer),
        "%I:%M",
        &info
      );

      String timeText =
        timeBuffer;

      if (
        timeText.startsWith(
          "0"
        )
      ) {
        timeText.remove(
          0,
          1
        );
      }

      char ampm[3];

      strftime(
        ampm,
        sizeof(ampm),
        "%p",
        &info
      );

      timeText +=
        " ";

      timeText +=
        ampm;

      tft.setCursor(
        6,
        8
      );

      tft.print(
        timeText
      );

      char dateBuffer[12];

      strftime(
        dateBuffer,
        sizeof(dateBuffer),
        "%b %d",
        &info
      );

      String dateText =
        dateBuffer;

      int x =
        235 -
        dateText.length() *
        12;

      tft.setCursor(
        x,
        8
      );

      tft.print(
        dateText
