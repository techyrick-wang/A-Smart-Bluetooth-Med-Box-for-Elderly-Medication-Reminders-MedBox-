struct Button {
  uint8_t pin = 0;

  bool raw = HIGH;
  bool previousRaw = HIGH;
  bool stable = HIGH;

  unsigned long changedAt = 0;

  bool queuedPress = false;

  void begin(uint8_t newPin) {
    pin = newPin;

    pinMode(
      pin,
      INPUT_PULLUP
    );

    raw = digitalRead(pin);
    previousRaw = raw;
    stable = raw;

    changedAt = millis();
  }

  void update() {
    raw =
      digitalRead(pin);

    if (
      raw !=
      previousRaw
    ) {
      previousRaw = raw;
      changedAt = millis();
    }

    if (
      millis() -
      changedAt >=
      30
    ) {
      if (
        raw !=
        stable
      ) {
        stable = raw;

        if (
          stable ==
          LOW
        ) {
          queuedPress = true;
        }
      }
    }
  }

  bool pressed() {
    if (
      !queuedPress
    ) {
      return false;
    }

    queuedPress = false;

    return true;
  }
};

