// ================================================================
// INTERNET SERVICE
// ================================================================

void refreshInternet() {
  if (
    !WiFi.isConnected()
  ) {
    return;
  }

  if (
    !locationReady
  ) {
    if (
      !loadLocation()
    ) {
      fetchIPLocation();
    }
  }

  if (
    locationReady
  ) {
    fetchWeather();
  }
}

void serviceInternet() {
  if (
    !WiFi.isConnected()
  ) {
    return;
  }

  if (
    refreshRequested &&
    millis() -
    lastInternetAttempt >=
    1000UL
  ) {
    refreshRequested =
      false;

    lastInternetAttempt =
      millis();

    refreshInternet();

    return;
  }

  if (
    weatherReady &&
    millis() -
    lastWeatherRefresh >=
    WEATHER_REFRESH_MS
  ) {
    lastWeatherRefresh =
      millis();

    fetchWeather();

    return;
  }

  if (
    !weatherReady &&
    millis() -
    lastInternetAttempt >=
    INTERNET_RETRY_MS
  ) {
    lastInternetAttempt =
      millis();

    refreshInternet();
  }
}

