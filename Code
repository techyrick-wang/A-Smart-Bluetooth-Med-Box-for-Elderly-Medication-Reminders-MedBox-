String cleanPhone(
  String phone
) {
  String output = "";

  for (
    unsigned int i = 0;
    i < phone.length();
    i++
  ) {
    char c =
      phone[i];

    if (
      c >= '0' &&
      c <= '9'
    ) {
      output += c;
    } else if (
      c ==
      '+' &&
      output.length() ==
      0
    ) {
      output += c;
    }
  }

  return output;
}

static void qrDisplayCallback(
  esp_qrcode_handle_t qrcode
) {
  int qrSize =
    esp_qrcode_get_size(
      qrcode
    );

  const int quiet =
    4;

  int totalModules =
    qrSize +
    quiet *
    2;

  int scale =
    190 /
    totalModules;

  if (
    scale <
    1
  ) {
    scale = 1;
  }

  int pixels =
    totalModules *
    scale;

  int startX =
    (
      240 -
      pixels
    ) /
    2;

  int startY =
    12;

  tft.fillRect(
    startX,
    startY,
    pixels,
    pixels,
    ST77XX_WHITE
  );

  for (
    int y = 0;
    y < qrSize;
    y++
  ) {
    for (
      int x = 0;
      x < qrSize;
      x++
    ) {
      if (
        esp_qrcode_get_module(
          qrcode,
          x,
          y
        )
      ) {
        tft.fillRect(
          startX +
          (
            x +
            quiet
          ) *
          scale,

          startY +
          (
            y +
            quiet
          ) *
          scale,

          scale,
          scale,

          ST77XX_BLACK
        );
      }
    }
  }
}

bool generateQR(
  String payload
) {
  esp_qrcode_config_t config =
    ESP_QRCODE_CONFIG_DEFAULT();

  config.display_func =
    qrDisplayCallback;

  esp_err_t result =
    esp_qrcode_generate(
      &config,
      payload.c_str()
    );

  return
    result ==
    ESP_OK;
}

void showQR(
