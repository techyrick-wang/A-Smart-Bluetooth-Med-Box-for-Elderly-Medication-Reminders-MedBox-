// ================================================================

String weatherName(
  int code
) {
  if (
    code ==
    0
  ) return "CLEAR";

  if (
    code ==
    1
  ) return "MOSTLY CLEAR";

  if (
    code ==
    2
  ) return "PARTLY CLOUDY";

  if (
    code ==
    3
  ) return "CLOUDY";

  if (
    code ==
    45 ||
    code ==
    48
  ) return "FOG";

  if (
    code >=
    51 &&
    code <=
    57
  ) return "DRIZZLE";

  if (
    code >=
    61 &&
    code <=
    67
  ) return "RAIN";

  if (
    code >=
    71 &&
    code <=
    77
  ) return "SNOW";

  if (
    code >=
    80 &&
    code <=
    82
  ) return "SHOWERS";

  if (
    code >=
    95
  ) return "THUNDER";

  return "UNKNOWN";
}

