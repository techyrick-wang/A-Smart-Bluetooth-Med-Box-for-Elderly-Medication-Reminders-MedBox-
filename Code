void updateTimerArea() {
  if (
    !timerRunning
  ) {
    return;
  }

  unsigned long elapsed =
    (
      millis() -
      timerStartedAt
    ) /
    1000UL;

  unsigned long total =
    timerDurationMs /
    1000UL;

  unsigned long remaining =
    elapsed <
    total
      ?
      total -
      elapsed
      :
      0;

  tft.fillRect(
    10,
    75,
    220,
    125,
    C_BG
  );

  drawCard(
    15,
    80,
    210,
    90
  );

  char buffer[20];

  snprintf(
    buffer,
    sizeof(buffer),
    "%02lu:%02lu",
    remaining /
    60UL,
    remaining %
    60UL
  );

  centeredText(
    buffer,
    105,
    5,
    C_GREEN
  );

  float progress =
    0;

  if (
    total >
    0
  ) {
    progress =
      (
        float
      )remaining /
      (
        float
      )total;
  }

  int width =
    188 *
    progress;

  tft.drawRect(
    25,
    181,
    190,
    12,
    C_GREY
  );

  tft.fillRect(
    26,
    182,
    width,
    10,
    C_GREEN
  );
}

