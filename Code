// ================================================================
// BUTTON HANDLER
// ================================================================

void handleButtons() {
  bool confirm =
    confirmButton.pressed();

  bool clear =
    clearButton.pressed();

  bool up =
    upButton.pressed();

  bool down =
    downButton.pressed();

  if (
    !confirm &&
    !clear &&
    !up &&
    !down
  ) {
    return;
  }

  clickBeep();

  // ------------------------------------------------------------
  // ALARM
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_ALARM
  ) {
    if (
      alarmReason ==
      1
    ) {
      if (
        confirm
      ) {
        markMedTaken(
          activeMedication
        );

        activeMedication =
          -1;

        successBeep();

        stopAlarm();

        return;
      }

      if (
        up
      ) {
        snoozeMed(
          activeMedication
        );

        activeMedication =
          -1;

        stopAlarm();

        return;
      }

      if (
        down
      ) {
        skipMed(
          activeMedication
        );

        activeMedication =
          -1;

        stopAlarm();

        return;
      }

      if (
        clear
      ) {
        activeMedication =
          -1;

        stopAlarm();

        return;
      }
    } else {
      stopAlarm();

      return;
    }
  }

  // ------------------------------------------------------------
  // QR
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_QR
  ) {
    if (
      confirm ||
      clear
    ) {
      currentScreen =
        qrReturnScreen;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // HOME
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_HOME
  ) {
    if (
      confirm
    ) {
      currentScreen =
        SCREEN_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // MAIN MENU
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_MENU
  ) {
    if (
      up
    ) {
      menuSelection--;

      if (
        menuSelection <
        0
      ) {
        menuSelection =
          MENU_COUNT -
          1;
      }

      redraw();
    }

    if (
      down
    ) {
      menuSelection++;

      if (
        menuSelection >=
        MENU_COUNT
      ) {
        menuSelection =
          0;
      }

      redraw();
    }

    if (
      clear
    ) {
      currentScreen =
        SCREEN_HOME;

      redraw();

      return;
    }

    if (
      confirm
    ) {
      switch (
        menuSelection
      ) {
        case 0:
          currentScreen =
            SCREEN_WEATHER;
          break;

        case 1:
          currentScreen =
            SCREEN_MED_MENU;
          break;

        case 2:
          currentScreen =
            timerRunning
              ?
              SCREEN_TIMER_RUNNING
              :
              SCREEN_TIMER_SELECT;
          break;

        case 3:
          currentScreen =
            SCREEN_KIT;
          break;

        case 4:
          pharmacySearchDone =
            false;

          pharmacyMessage =
            "PRESS CONFIRM";

          currentScreen =
            SCREEN_PHARMACY_LIST;
          break;

        case 5:
          currentScreen =
            SCREEN_EMERGENCY;
          break;

        case 6:
          currentScreen =
            SCREEN_AID_MENU;
          break;

        case 7:
          currentScreen =
            SCREEN_LOCATION;
          break;

        case 8:
          currentScreen =
            SCREEN_ALERT_TEST;
          break;

        case 9:
          currentScreen =
            SCREEN_DEVICE;
          break;
      }

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // WEATHER
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_WEATHER
  ) {
    if (
      confirm
    ) {
      refreshRequested =
        true;
    }

    if (
      clear
    ) {
      currentScreen =
        SCREEN_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // MED MENU
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_MED_MENU
  ) {
    if (
      up
    ) {
      medMenuSelection--;

      if (
        medMenuSelection <
        0
      ) {
        medMenuSelection =
          4;
      }

      redraw();
    }

    if (
      down
    ) {
      medMenuSelection++;

      if (
        medMenuSelection >
        4
      ) {
        medMenuSelection =
          0;
      }

      redraw();
    }

    if (
      clear
    ) {
      currentScreen =
        SCREEN_MENU;

      redraw();

      return;
    }

    if (
      confirm
    ) {
      if (
        medMenuSelection <
        3
      ) {
        editMedSlot =
          medMenuSelection;

        editHour =
          medHour[
            editMedSlot
          ];

        editMinute =
          medMinute[
            editMedSlot
          ];

        editMedField =
          0;

        currentScreen =
          SCREEN_MED_EDIT;

        redraw();

        return;
      }

      if (
        medMenuSelection ==
        3
      ) {
        medStatusSelection =
          0;

        currentScreen =
          SCREEN_MED_STATUS;

        redraw();

        return;
      }

      medStockSelection =
        0;

      currentScreen =
        SCREEN_MED_STOCK;

      redraw();

      return;
    }

    return;
  }

  // ------------------------------------------------------------
  // MED EDIT
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_MED_EDIT
  ) {
    if (
      clear
    ) {
      currentScreen =
        SCREEN_MED_MENU;

      redraw();

      return;
    }

    if (
      editMedField ==
      0
    ) {
      if (
        up
      ) {
        editHour++;

        if (
          editHour >
          23
        ) {
          editHour =
            0;
        }

        redraw();
      }

      if (
        down
      ) {
        editHour--;

        if (
          editHour <
          0
        ) {
          editHour =
            23;
        }

        redraw();
      }

      if (
        confirm
      ) {
        editMedField =
          1;

        redraw();
      }

      return;
    }

    if (
      up
    ) {
      editMinute +=
        5;

      if (
        editMinute >=
        60
      ) {
        editMinute =
          0;
      }

      redraw();
    }

    if (
      down
    ) {
      editMinute -=
        5;

      if (
        editMinute <
        0
      ) {
        editMinute =
          55;
      }

      redraw();
    }

    if (
      confirm
    ) {
      medHour[
        editMedSlot
      ] =
        editHour;

      medMinute[
        editMedSlot
      ] =
        editMinute;

      medTaken[
        editMedSlot
      ] =
        false;

      medAlerted[
        editMedSlot
      ] =
        false;

      medSkipped[
        editMedSlot
      ] =
        false;

      medSnoozeUntil[
        editMedSlot
      ] =
        0;

      saveMedSchedule();
      saveMedDay();

      successBeep();

      currentScreen =
        SCREEN_MED_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // MED STATUS
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_MED_STATUS
  ) {
    if (
      up
    ) {
      medStatusSelection--;

      if (
        medStatusSelection <
        0
      ) {
        medStatusSelection =
          MED_COUNT -
          1;
      }

      redraw();
    }

    if (
      down
    ) {
      medStatusSelection++;

      if (
        medStatusSelection >=
        MED_COUNT
      ) {
        medStatusSelection =
          0;
      }

      redraw();
    }

    if (
      confirm
    ) {
      if (
        medTaken[
          medStatusSelection
        ]
      ) {
        medTaken[
          medStatusSelection
        ] =
          false;

        saveMedDay();
      } else {
        markMedTaken(
          medStatusSelection
        );
      }

      successBeep();

      redraw();
    }

    if (
      clear
    ) {
      currentScreen =
        SCREEN_MED_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // MED STOCK
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_MED_STOCK
  ) {
    if (
      up
    ) {
      medStockSelection--;

      if (
        medStockSelection <
        0
      ) {
        medStockSelection =
          MED_COUNT -
          1;
      }

      redraw();
    }

    if (
      down
    ) {
      medStockSelection++;

      if (
        medStockSelection >=
        MED_COUNT
      ) {
        medStockSelection =
          0;
      }

      redraw();
    }

    if (
      confirm
    ) {
      if (
        medStock[
          medStockSelection
        ] <
        0
      ) {
        medStock[
          medStockSelection
        ] =
          1;
      } else {
        medStock[
          medStockSelection
        ]++;
      }

      saveMedSchedule();

      successBeep();

      redraw();
    }

    if (
      clear
    ) {
      currentScreen =
        SCREEN_MED_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // TIMER SELECT
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_TIMER_SELECT
  ) {
    if (
      up
    ) {
      timerSelection--;

      if (
        timerSelection <
        0
      ) {
        timerSelection =
          TIMER_COUNT -
          1;
      }

      redraw();
    }

    if (
      down
    ) {
      timerSelection++;

      if (
        timerSelection >=
        TIMER_COUNT
      ) {
        timerSelection =
          0;
      }

      redraw();
    }

    if (
      confirm
    ) {
      timerDurationMs =
        timerPresetSeconds[
          timerSelection
        ] *
        1000UL;

      timerStartedAt =
        millis();

      timerRunning =
        true;

      lastTimerSecond =
        0xFFFFFFFFUL;

      currentScreen =
        SCREEN_TIMER_RUNNING;

      successBeep();

      redraw();
    }

    if (
      clear
    ) {
      currentScreen =
        SCREEN_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // TIMER RUNNING
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_TIMER_RUNNING
  ) {
    if (
      clear
    ) {
      timerRunning =
        false;

      currentScreen =
        SCREEN_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // KIT
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_KIT
  ) {
    if (
      up
    ) {
      kitSelection--;

      if (
        kitSelection <
        0
      ) {
        kitSelection =
          KIT_COUNT -
          1;
      }

      redraw();
    }

    if (
      down
    ) {
      kitSelection++;

      if (
        kitSelection >=
        KIT_COUNT
      ) {
        kitSelection =
          0;
      }

      redraw();
    }

    if (
      confirm
    ) {
      kitChecked[
        kitSelection
      ] =
        !kitChecked[
          kitSelection
        ];

      redraw();
    }

    if (
      clear
    ) {
      currentScreen =
        SCREEN_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // PHARMACY LIST
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_PHARMACY_LIST
  ) {
    if (
      clear
    ) {
      currentScreen =
        SCREEN_MENU;

      redraw();

      return;
    }

    if (
      !pharmacySearchDone
    ) {
      if (
        confirm
      ) {
        searchPharmacies();
      }

      return;
    }

    if (
      pharmacyCount ==
      0
    ) {
      if (
        confirm
      ) {
        searchPharmacies();
      }

      return;
    }

    if (
      up
    ) {
      pharmacySelection--;

      if (
        pharmacySelection <
        0
      ) {
        pharmacySelection =
          pharmacyCount -
          1;
      }

      redraw();
    }

    if (
      down
    ) {
      pharmacySelection++;

      if (
        pharmacySelection >=
        pharmacyCount
      ) {
        pharmacySelection =
          0;
      }

      redraw();
    }

    if (
      confirm
    ) {
      currentScreen =
        SCREEN_PHARMACY_DETAIL;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // PHARMACY DETAILS
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_PHARMACY_DETAIL
  ) {
    if (
      clear
    ) {
      currentScreen =
        SCREEN_PHARMACY_LIST;

      redraw();

      return;
    }

    if (
      up
    ) {
      String mapUrl =
        "https://www.google.com/maps/dir/?api=1&destination=";

      mapUrl +=
        String(
          pharmacies[
            pharmacySelection
          ].lat,
          6
        );

      mapUrl +=
        ",";

      mapUrl +=
        String(
          pharmacies[
            pharmacySelection
          ].lon,
          6
        );

      showQR(
        mapUrl,
        "SCAN FOR DIRECTIONS",
        SCREEN_PHARMACY_DETAIL
      );

      return;
    }

    if (
      confirm
    ) {
      String phone =
        pharmacies[
          pharmacySelection
        ].phone;

      if (
        phone.length()
      ) {
        phone =
          cleanPhone(
            phone
          );

        showQR(
          "tel:" +
          phone,
          "SCAN TO CALL",
          SCREEN_PHARMACY_DETAIL
        );
      } else {
        errorBeep();
      }
    }

    return;
  }

  // ------------------------------------------------------------
  // EMERGENCY
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_EMERGENCY
  ) {
    if (
      up
    ) {
      showQR(
        emergencyQRText(),
        "EMERGENCY CARD",
        SCREEN_EMERGENCY
      );

      return;
    }

    if (
      clear
    ) {
      currentScreen =
        SCREEN_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // FIRST AID MENU
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_AID_MENU
  ) {
    if (
      up
    ) {
      aidSelection--;

      if (
        aidSelection <
        0
      ) {
        aidSelection =
          AID_COUNT -
          1;
      }

      redraw();
    }

    if (
      down
    ) {
      aidSelection++;

      if (
        aidSelection >=
        AID_COUNT
      ) {
        aidSelection =
          0;
      }

      redraw();
    }

    if (
      confirm
    ) {
      currentScreen =
        SCREEN_AID_VIEW;

      redraw();
    }

    if (
      clear
    ) {
      currentScreen =
        SCREEN_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // AID VIEW
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_AID_VIEW
  ) {
    if (
      confirm ||
      clear
    ) {
      currentScreen =
        SCREEN_AID_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // LOCATION
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_LOCATION
  ) {
    if (
      confirm
    ) {
      locationReady =
        false;

      weatherReady =
        false;

      fetchIPLocation();

      if (
        locationReady
      ) {
        fetchWeather();
      }

      redraw();
    }

    if (
      clear
    ) {
      currentScreen =
        SCREEN_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // ALERT TEST
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_ALERT_TEST
  ) {
    if (
      confirm
    ) {
      startAlarm(
        3
      );

      return;
    }

    if (
      clear
    ) {
      currentScreen =
        SCREEN_MENU;

      redraw();
    }

    return;
  }

  // ------------------------------------------------------------
  // DEVICE
  // ------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_DEVICE
  ) {
    if (
      confirm
    ) {
      connectWiFi();

      if (
        WiFi.isConnected()
      ) {
        startClock();

        refreshRequested =
          true;
      }

      redraw();

      return;
    }

    if (
      up
    ) {
      lightTheme =
        !lightTheme;

      prefs.putBool(
        "light",
        lightTheme
      );

      redraw();
    }

    if (
      clear
    ) {
      currentScreen =
        SCREEN_MENU;

      redraw();
    }

    return;
  }
}

