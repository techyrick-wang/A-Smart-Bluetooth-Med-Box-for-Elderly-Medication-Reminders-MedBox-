String shortenText(
  String text,
  int maxLength
) {
  if (
    (int)text.length() <=
    maxLength
  ) {
    return text;
  }

  if (
    maxLength <=
    3
  ) {
    return
      text.substring(
        0,
        maxLength
      );
  }

  return
    text.substring(
      0,
      maxLength - 3
    ) +
    "...";
}

void centeredText(
  String text,
  int y,
  int size,
  uint16_t color = C_TEXT
) {
  tft.setTextSize(size);

  tft.setTextColor(color);

  int width =
    text.length() *
    6 *
    size;

  int x =
    (
      SCREEN_W -
      width
    ) /
    2;

  if (
    x <
    0
  ) {
    x = 0;
  }

  tft.setCursor(
    x,
    y
  );

  tft.print(
    text
  );
}

