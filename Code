bool searchPharmacies() {
  pharmacyCount =
    0;

  pharmacySelection =
    0;

  pharmacySearchDone =
    false;

  if (
    !WiFi.isConnected()
  ) {
    pharmacyMessage =
      "WIFI OFFLINE";

    pharmacySearchDone =
      true;

    redraw();

    return false;
  }

  if (
    !locationReady
  ) {
    if (
      !loadLocation()
    ) {
      if (
        !fetchIPLocation()
      ) {
        pharmacyMessage =
          "NO LOCATION";

        pharmacySearchDone =
          true;

        redraw();

        return false;
      }
    }
  }

  clearDisplay();

  drawTopBar();

  centeredText(
    "PHARMACY",
    55,
    3,
    C_HEADER
  );

  centeredText(
    "SEARCHING...",
    110,
    3,
    C_YELLOW
  );

  centeredText(
    "OPENSTREETMAP",
    160,
    1,
    C_GREY
  );

  String query =
    "[out:json][timeout:15];(";

  query +=
    "node[\"amenity\"=\"pharmacy\"](around:5000,";

  query +=
    String(
      latitude,
      6
    );

  query +=
    ",";

  query +=
    String(
      longitude,
      6
    );

  query +=
    ");";

  query +=
    "way[\"amenity\"=\"pharmacy\"](around:5000,";

  query +=
    String(
      latitude,
      6
    );

  query +=
    ",";

  query +=
    String(
      longitude,
      6
    );

  query +=
    ");";

  query +=
    "relation[\"amenity\"=\"pharmacy\"](around:5000,";

  query +=
    String(
      latitude,
      6
    );

  query +=
    ",";

  query +=
    String(
      longitude,
      6
    );

  query +=
    ");";

  query +=
    ");out center 40;";

  String url =
    "https://overpass-api.de/api/interpreter?data=";

  url +=
    urlEncode(
      query
    );

  Serial.println();

  Serial.println(
    "OVERPASS REQUEST"
  );

  WiFiClientSecure client;

  client.setInsecure();

  HTTPClient http;

  if (
    !http.begin(
      client,
      url
    )
  ) {
    pharmacyMessage =
      "HTTP ERROR";

    pharmacySearchDone =
      true;

    redraw();

    return false;
  }

  http.setTimeout(
    20000
  );

  http.setFollowRedirects(
    HTTPC_FORCE_FOLLOW_REDIRECTS
  );

  http.addHeader(
    "User-Agent",
    "MedKit-XIAO-V47"
  );

  int code =
    http.GET();

  Serial.print(
    "Overpass HTTP: "
  );

  Serial.println(
    code
  );

  if (
    code !=
    HTTP_CODE_OK
  ) {
    if (
      code <
      0
    ) {
      Serial.print(
        "OVERPASS NETWORK ERROR: "
      );

      Serial.println(
        HTTPClient::errorToString(
          code
        )
      );
    }

    http.end();

    pharmacyMessage =
      "API ERROR";

    pharmacySearchDone =
      true;

    errorBeep();

    redraw();

    return false;
  }

  String payload =
    http.getString();

  http.end();

  Serial.print(
    "Overpass bytes: "
  );

  Serial.println(
    payload.length()
  );

  JsonDocument doc;

  DeserializationError error =
    deserializeJson(
      doc,
      payload
    );

  if (
    error
  ) {
    Serial.print(
      "OVERPASS JSON ERROR: "
    );

    Serial.println(
      error.c_str()
    );

    pharmacyMessage =
      "DATA ERROR";

    pharmacySearchDone =
      true;

    errorBeep();

    redraw();

    return false;
  }

  JsonArray elements =
    doc["elements"]
      .as<JsonArray>();

  Serial.print(
    "OSM elements: "
  );

  Serial.println(
    elements.size()
  );

  for (
    JsonObject element :
    elements
  ) {
    double pLat = 0;
    double pLon = 0;

    String type =
      element["type"] |
      "";

    if (
      type ==
      "node"
    ) {
      pLat =
        element["lat"] |
        0.0;

      pLon =
        element["lon"] |
        0.0;
    } else {
      pLat =
        element["center"]["lat"] |
        0.0;

      pLon =
        element["center"]["lon"] |
        0.0;
    }

    if (
      pLat ==
      0 &&
      pLon ==
      0
    ) {
      continue;
    }

    JsonObject tags =
      element["tags"]
        .as<JsonObject>();

    String name =
      tags["name"] |
      "";

    if (
      !name.length()
    ) {
      name =
        tags["brand"] |
        "";
    }

    if (
      !name.length()
    ) {
      name =
        tags["operator"] |
        "";
    }

    if (
      !name.length()
    ) {
      name =
        "PHARMACY";
    }

    String phone =
      tags["phone"] |
      "";

    if (
      !phone.length()
    ) {
      phone =
        tags["contact:phone"] |
        "";
    }

    String hours =
      tags["opening_hours"] |
      "";

    String address =
      buildPharmacyAddress(
        tags
      );

    float distance =
      calculateDistanceKm(
        latitude,
        longitude,
        pLat,
        pLon
      );

    addPharmacy(
      name,
      address,
      phone,
      hours,
      pLat,
      pLon,
      distance
    );
  }

  pharmacySearchDone =
    true;

  if (
    pharmacyCount ==
    0
  ) {
    pharmacyMessage =
      "NONE FOUND";

    errorBeep();

    redraw();

    return false;
  }

  pharmacyMessage =
    "FOUND";

  Serial.print(
    "PHARMACIES LOADED: "
  );

  Serial.println(
    pharmacyCount
  );

  for (
    int i = 0;
    i < pharmacyCount;
    i++
  ) {
    Serial.print(
      i +
      1
    );

    Serial.print(
      ". "
    );

    Serial.print(
      pharmacies[i].name
    );

    Serial.print(
      " | "
    );

    Serial.print(
      pharmacies[i].distanceKm,
      2
    );

    Serial.println(
      " km"
    );
  }

  successBeep();

  redraw();

  return true;
}

