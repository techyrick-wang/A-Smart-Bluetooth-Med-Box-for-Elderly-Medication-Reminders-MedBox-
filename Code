void setup() {
  Serial.begin(
    115200
  );

  delay(500);

  Serial.println();

  Serial.println(
    "============================="
  );

  Serial.println(
    "MEDKIT V4.7"
  );

  Serial.println(
    "XIAO ESP32-S3"
  );

  Serial.println(
    "DIRECT WIFI + OLD APIs"
  );

  Serial.println(
    "============================="
  );

  prefs.begin(
    "medkit",
    false
  );

  lightTheme =
    prefs.getBool(
      "light",
      false
    );

  loadMedSchedule();

  loadEmergency();

  loadLocation();

  confirmButton.begin(
    BTN_CONFIRM
  );

  clearButton.begin(
    BTN_CLEAR
  );

  upButton.begin(
    BTN_UP
  );

  downButton.begin(
    BTN_DOWN
  );

  setupBuzzer();

  pinMode(
    TFT_BL,
    OUTPUT
  );

  digitalWrite(
    TFT_BL,
    HIGH
  );

  SPI.begin(
    TFT_SCLK,
    -1,
    TFT_MOSI,
    TFT_CS
  );

  tft.init(
    240,
    240
  );

  tft.setRotation(
    0
  );

  tft.setSPISpeed(
    40000000
  );

  drawBoot();

  connectWiFi();

  if (
    WiFi.isConnected()
  ) {
    startClock();

    refreshRequested =
      true;
  }

  currentScreen =
    SCREEN_HOME;

  redraw();

  Serial.println(
    "MEDKIT READY"
  );
}

// ================================================================
// LOOP
// ================================================================

void loop() {
  confirmButton.update();
  clearButton.update();
  upButton.update();
  downButton.update();

  handleButtons();

  serviceSerial();

  serviceWiFi();

  serviceClock();

  serviceInternet();

  static bool medStateLoaded =
    false;

  if (
    clockReady &&
    !medStateLoaded
  ) {
    loadMedDay();

    medStateLoaded =
      true;

    redraw();
  }

  serviceMedication();

  serviceTimer();

  serviceAlarm();

  // --------------------------------------------------------------
  // CLOCK REDRAW
  // --------------------------------------------------------------

  if (
    clockReady &&
    currentScreen !=
    SCREEN_QR &&
    currentScreen !=
    SCREEN_ALARM
  ) {
    struct tm info;

    if (
      getLocalTime(
        &info,
        1
      )
    ) {
      int minuteKey =
        info.tm_hour *
        60 +
        info.tm_min;

      if (
        minuteKey !=
        lastClockMinute
      ) {
        lastClockMinute =
          minuteKey;

        if (
          currentScreen ==
          SCREEN_HOME
        ) {
          redraw();
        } else if (
          currentScreen !=
          SCREEN_TIMER_RUNNING
        ) {
          drawTopBar();
        }
      }
    }
  }

  // --------------------------------------------------------------
  // TIMER AREA ONLY
  // --------------------------------------------------------------

  if (
    currentScreen ==
    SCREEN_TIMER_RUNNING &&
    timerRunning
  ) {
    unsigned long second =
      (
        millis() -
        timerStartedAt
      ) /
      1000UL;

    if (
      second !=
      lastTimerSecond
    ) {
      lastTimerSecond =
        second;

      updateTimerArea();
    }
  }

  // --------------------------------------------------------------
  // FULL REDRAW ONLY WHEN NEEDED
  // --------------------------------------------------------------

  if (
    uiDirty
  ) {
    uiDirty =
      false;

    drawCurrentScreen();
  }

  delay(2);
}
